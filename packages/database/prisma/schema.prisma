generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// --- ENUMS: The Backbone of Logic ---
enum UserRole {
  SUPER_ADMIN
  AGENCY_MANAGER
  PROJECT_LEAD
  CONTRIBUTOR
  CLIENT
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  AT_RISK
  COMPLETED
  MAINTENANCE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

// --- CORE MODELS ---

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  name          String?
  role          UserRole  @default(CONTRIBUTOR)
  avatarUrl     String?   // S3 Link
  
  // Relationships
  managedProjects Project[] @relation("ProjectLead")
  tasks          Task[]
  assignedProjects ProjectMember[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email, role]) // Optimized for auth and permission checks
}

model Project {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  slug          String        @unique
  status        ProjectStatus @default(DISCOVERY)
  budget        Decimal       @db.Decimal(12, 2)
  
  // High-Performance Resource Mapping
  leadId        String        @db.Uuid
  lead          User          @relation("ProjectLead", fields: [leadId], references: [id])
  members       ProjectMember[]
  tasks         Task[]
  invoices      Invoice[]
  
  // S3 Vault Links
  contractUrl   String?
  onboardingDoc String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([leadId])
}

model ProjectMember {
  projectId String  @db.Uuid
  userId    String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId]) // Composite Key for performance
}

model Task {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  priority    Int      @default(1) // 1-5 scale
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id])
  assigneeId  String?  @db.Uuid
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  
  estimatedHours Float?
  actualHours    Float?

  @@index([projectId, assigneeId])
}

model Invoice {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String        @db.Uuid
  project     Project       @relation(fields: [projectId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  stripeId    String?       @unique

  @@index([projectId, status])
}